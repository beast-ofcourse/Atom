{
  "name": "atom-agent",
  "version": "0.3.0",
  "description": "Minimal chatbot on OpenCode Zen (OpenAI-compatible chat/completions) with an Ink (React) TUI.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "atom": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "ai-agent",
    "chatbot",
    "tui",
    "ink",
    "coding-agent"
  ],
  "scripts": {
    "start": "tsx src/cli.tsx",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "ink": "7.1.1",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "ink-testing-library": "4.0.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
