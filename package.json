{
  "name": "atom-agent",
  "version": "1.0.0",
  "description": "Agentic terminal coding assistant: multi-provider LLM loop with local file/shell/web tools in an Ink (React) TUI.",
  "type": "module",
  "license": "MIT",
  "author": "beast-ofcourse",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beast-ofcourse/Atom.git"
  },
  "homepage": "https://github.com/beast-ofcourse/Atom#readme",
  "bugs": {
    "url": "https://github.com/beast-ofcourse/Atom/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "atom": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "ai-agent",
    "chatbot",
    "tui",
    "ink",
    "coding-agent"
  ],
  "scripts": {
    "start": "tsx src/cli.tsx",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "ink": "7.1.1",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "ink-testing-library": "4.0.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
