OPENCODE_ZEN_API_KEY=sk-your-key-from-https://opencode.ai/auth
# Strong tool-capable default for multi-step work; override as needed (e.g. kimi-k2.6, glm-5.2, or a free model like big-pickle for quick turns)
OPENCODE_ZEN_MODEL=deepseek-v4-pro
# OPENCODE_ZEN_ENDPOINT=https://opencode.ai/zen/v1/chat/completions
# OPENCODE_AGENTS_PATH=  # optional override for the AGENTS.md appended to the system prompt (default: <cwd>/AGENTS.md)
# Other providers (env wins over ~/.atom/auth.json; or paste once via /provider):
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# DEEPSEEK_API_KEY=sk-...
# MISTRAL_API_KEY=...
# GEMINI_API_KEY=...  # GOOGLE_API_KEY also accepted
# openai-compatible uses stored key + baseURL only (set via /provider).
# Local observability (traces under ~/.atom/telemetry/, /telemetry + /dashboard):
# ATOM_TELEMETRY=0  # uncomment to disable recording entirely (wins over atom.json)
